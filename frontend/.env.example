# Base URL for the markit HTTP API. Defaults to /api/v1 when unset.
VITE_API_BASE=/api/v1

# Google sign-in (optional). When empty, the Google button is hidden and the app
# still works with email + password. To enable real Google sign-in:
#   1. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
#      -> type "Web application".
#   2. Add Authorized JavaScript origins: http://localhost:5173 (dev) and your prod URL.
#   3. Copy the Client ID here (frontend) AND set the same value as GOOGLE_CLIENT_ID
#      in the backend environment (it verifies the token's audience against it).
# Put your real value in .env.local (git-ignored), not here.
VITE_GOOGLE_CLIENT_ID=
